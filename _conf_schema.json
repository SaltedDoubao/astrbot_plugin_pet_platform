{
  "enabled": {
    "type": "bool",
    "default": true,
    "description": "启用 dsh_pet 平台"
  },
  "bind_host": {
    "type": "string",
    "default": "127.0.0.1",
    "description": "HTTP 监听地址；远程访问改为 0.0.0.0 并配置防火墙/反向代理"
  },
  "bind_port": {
    "type": "int",
    "default": 16199,
    "description": "HTTP 监听端口"
  },
  "token": {
    "type": "string",
    "default": "",
    "secret": true,
    "description": "桌宠访问令牌；留空则拒绝所有请求"
  },
  "pet_ids": {
    "type": "list",
    "default": ["main"],
    "description": "允许的 petId 白名单"
  },
  "event_buffer_size": {
    "type": "int",
    "default": 256,
    "description": "SSE 环形缓冲大小"
  },
  "whisper_provider_id": {
    "type": "string",
    "default": "",
    "description": "碎碎念使用的 provider；留空用当前会话 provider"
  }
}
